[Unit]
Description=ForgePanel privileged agent
Documentation=https://github.com/zarkostrelec/forgepanel
After=network.target mariadb.service mysql.service
Wants=mariadb.service

[Service]
Type=notify
# forgepanel-php = symlink na panelov PHP (installer ga postavlja) — agent ne
# ovisi o verziji u imenu interpretera niti o update-alternatives /usr/bin/php
ExecStart=/usr/local/bin/forgepanel-php /opt/forgepanel/agent/bin/forge-agentd /etc/forgepanel/agent.ini
Restart=always
RestartSec=3

# Watchdog: daemon pinga svakih 10 s. Visok prag jer agent izvršava i dugotrajne
# operacije (apt install, backup, AI upit) sinkrono u glavnoj petlji — kraći prag
# bi ga ubio usred legitimnog posla.
WatchdogSec=1200

# Hardening — agent je root sistemski daemon. Sigurnosna granica je WHITELIST
# operacija + validacija parametara (poglavlje 3/8), NE filesystem confinement:
# agent legitimno instalira pakete (apt/dpkg pišu po /usr,/etc,/var/cache,/var/lib)
# i uređuje confige svih servisa, pa ProtectSystem=strict ga onemogućuje u poslu.
# Zadržavamo kernel/ostale zaštite.
RuntimeDirectory=forgepanel
RuntimeDirectoryMode=0755
# ProtectHome=read-only čuva /home i /root, ReadWritePaths probija samo za
# claude state (Forge AI lokalni mod); '-' = ne-fatalno ako putanja ne postoji
ProtectHome=read-only
ReadWritePaths=-/root/.claude -/root/.claude.json -/root/.config -/root/.cache -/root/.npm
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectControlGroups=false
RestrictSUIDSGID=false
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute namjerno ISKLJUČEN: blokira W^X (JIT) — rušio bi
# Forge AI lokalni claude (Node/V8 JIT) i već je gasio PCRE JIT u panelovom PHP-u
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
